# Copy to .env; paths are resolved from the project directory.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
VISIONX_DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./visionx.db
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
WEIGHTS_DIR=weights
MAX_FILE_SIZE_MB=100
GENERAL_MODEL=yolo26n.pt
HUMAN_MODEL=yolo26n.pt
SHIP_MODEL=yolo26n.pt
CONTAINER_MODEL=yolo26n.pt
POSE_MODEL=yolo26n-pose.pt
DEFAULT_CONFIDENCE=0.50
DEFAULT_IOU=0.45
MAX_DETECTIONS=300
INFERENCE_TIMEOUT=120
OUTPUT_TTL_SECONDS=3600
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000", "http://127.0.0.1:8000"]
AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Docker compose requires unique strong values for ADMIN_PASSWORD and POSTGRES_PASSWORD.
POSTGRES_PASSWORD=

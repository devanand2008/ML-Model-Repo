FROM node:22-bookworm-slim AS frontend
WORKDIR /build/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_HOSTING_MODE=free-hybrid
ENV VITE_PUBLIC_ADMIN=true
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY scripts/gateway-requirements.txt /app/scripts/gateway-requirements.txt
RUN pip install --no-cache-dir -r scripts/gateway-requirements.txt
COPY scripts/free_gateway.py /app/scripts/free_gateway.py
COPY --from=frontend /build/frontend/dist /app/frontend/dist
RUN useradd --create-home --uid 10001 transitopt
USER transitopt
ENV PYTHONUNBUFFERED=1 PORT=10000
EXPOSE 10000
CMD ["python", "scripts/free_gateway.py"]
